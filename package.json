{
  "name": "ndominik12-projects-page",
  "version": "0.1.0",
  "private": true,
  "description": "Project scaffold for ndominik12 projects page (TypeScript + Node + Vite)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "server": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "Dominik Nagy",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.5.1",
    "@types/supertest": "^2.0.12",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vite": "^7.1.11"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": ["ts", "js"],
    "roots": ["<rootDir>/test"]
  }
}